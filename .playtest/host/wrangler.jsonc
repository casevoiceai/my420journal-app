{
  "name": "my420journal-wg-playtest-1-3",
  "main": "index.js",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/playtest", "/robots.txt", "/api/*"]
  },
  "vars": {
    "WEED_GOBLINS_NARRATION_WORKER_URL": "https://my420journal-weed-goblins-narration-staging.casevoice-ai.workers.dev",
    "WEED_GOBLINS_PAGES_PREVIEW_HOST": "casevoice-ai.workers.dev"
  }
}
