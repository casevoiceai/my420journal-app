{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "my420journal-weed-goblins-narration",
  "main": "index.js",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FREE_TEXT_RATE_LIMITER",
        "class_name": "WeedGoblinsFreeTextRateLimiter"
      }
    ]
  },
  "exports": {
    "WeedGoblinsFreeTextRateLimiter": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
