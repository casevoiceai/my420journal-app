{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "my420journal-weed-goblins-narration",
  "main": "index.js",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "FREE_TEXT_RATE_LIMITER",
        "class_name": "WeedGoblinsFreeTextRateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WeedGoblinsFreeTextRateLimiter"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "env": {
    "staging": {
      "workers_dev": true,
      "durable_objects": {
        "bindings": [
          {
            "name": "FREE_TEXT_RATE_LIMITER",
            "class_name": "WeedGoblinsFreeTextRateLimiter"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["WeedGoblinsFreeTextRateLimiter"]
        }
      ]
    }
  }
}
